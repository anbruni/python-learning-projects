# .env.example — template per le variabili d'ambiente dell'app
#
# ISTRUZIONI:
#   1. Copia questo file: cp .env.example .env
#   2. Sostituisci i valori con i tuoi dati reali
#   3. NON committare il file .env (già in .gitignore)
#
# Il file .env.example SI committa — è documentazione, non un segreto.

# --- RICHIESTE (obbligatorie — l'app non parte senza) ---
APP_API_KEY=la_tua_api_key_qui
APP_BASE_URL=https://jsonplaceholder.typicode.com

# --- OPZIONALI (hanno un default se non specificate) ---
APP_MAX_RESULTS=10
APP_LANGUAGE=en-US
APP_DEBUG=false
